{
    "name": "podcasthosting/podcaster-sdk",
    "description": "Toolset to easily connect a client to the podcaster API.",
    "keywords": ["api", "podcaster", "hosting"],
    "license": "GPL-2.0+",
    "type": "library",
    "require": {
        "php": ">=8.3",
        "league/oauth2-client": "^2.4",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Podcaster\\": "src/Podcaster/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Podcaster\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
